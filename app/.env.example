# PACTE — configuration de la persistance.
#
# Par défaut (aucune variable définie), PACTE utilise un stockage local
# sur disque (server/data/db.json) : idéal pour développer, tester ou
# s'auto-héberger sans dépendance externe.
#
# Pour utiliser Supabase (recommandé en production / multi-utilisateurs),
# renseignez les variables ci-dessous puis définissez DATA_BACKEND=supabase
# (ou laissez vide : la présence de SUPABASE_URL suffit à l'activer).

# DATA_BACKEND=supabase

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optionnel — utilisés uniquement si vous exposez aussi un client Supabase
# côté navigateur (non nécessaire : le front ne parle qu'à /api/*).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
